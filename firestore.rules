rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // دالة مساعدة للتحقق من تسجيل الدخول
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // دالة مساعدة للتحقق من أن المستخدم يعدل بياناته الخاصة
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // دالة للتحقق من دور المستخدم
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isSupplier() {
      return isAuthenticated() && getUserRole() == 'supplier';
    }

    // إعدادات التطبيق والأقسام (قراءة للجميع)
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // المنتجات (قراءة للجميع، والكتابة للمدير والمورد)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() || isSupplier();
    }

    // المستخدمين (كل مستخدم يرى ويعدل بياناته فقط، والمدير يرى ويعدل للجميع)
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    // المحافظ (قراءة للمالك فقط)
    match /wallets/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // الطلبات (قراءة للمالك، إنشاء للمستخدم المسجل، تعديل/قراءة للجميع للمدير)
    match /orders/{orderId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    // السلة (كل مستخدم يقرأ ويعدل سلته)
    match /carts/{userId}/items/{itemId} {
      allow read, write: if isOwner(userId);
    }

    // المحادثات - مشكلتي (للمستخدم نفسه)
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // تم إزالة القاعدة الاحتياطية لأسباب أمنية
  }
}
