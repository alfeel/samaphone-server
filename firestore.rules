rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // دالة مساعدة للتحقق من تسجيل الدخول
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // دالة مساعدة للتحقق من أن المستخدم يعدل بياناته الخاصة
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // إعدادات التطبيق والأقسام (قراءة للجميع)
    match /settings/{document=**} {
      allow read: if true;
      allow write: if false; // التعديل من لوحة التحكم فقط
    }

    // المنتجات (قراءة للجميع)
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // المستخدمين (كل مستخدم يرى ويعدل بياناته فقط)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // المحافظ (قراءة للمالك فقط)
    match /wallets/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // الطلبات (قراءة للمالك، إنشاء للمستخدم المسجل)
    match /orders/{orderId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    
    // السلة (كل مستخدم يقرأ ويعدل سلته)
    match /carts/{userId}/items/{itemId} {
      allow read, write: if isOwner(userId);
    }

    // المحادثات - مشكلتي (للمستخدم نفسه)
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // قاعدة افتراضية: السماح للمستخدمين المسجلين بالقراءة والكتابة لباقي المجموعات كحل مؤقت لمنع توقف التطبيق
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
